# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Ollama backends (SPLIT) ---
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_BASE_URL=http://10.0.0.11:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b-q8_0
EMBEDDING_MODEL=qwen-speed-embed
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_MAX_RETRIES=1

# --- Timeouts (ALL support -1 = disabled) ---
HTTP_CLIENT_TIMEOUT_SECONDS=-1
OLLAMA_CHAT_TIMEOUT_SECONDS=-1
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=-1
STREAMING_IDLE_TIMEOUT_SECONDS=-1
CHROMA_REQUEST_TIMEOUT_SECONDS=-1
FILE_OP_TIMEOUT_SECONDS=-1
BACKGROUND_JOB_TIMEOUT_SECONDS=-1
HEALTH_CHECK_TIMEOUT_SECONDS=20
CATEGORY_LOCK_READ_TIMEOUT_MS=1000

# --- Chroma ---
# CHROMA_URL=http://localhost:8001
CHROMA_URL=http://10.0.0.11:8001
CHROMA_COLLECTION_PREFIX=rules_

# --- Rulesets ---
RULESET_MAP_FILE=./rulesets.json
RULESETS_DIR=./rulesets/
RELOAD_ON_STARTUP=false
WATCH_RULESETS=true
WATCHER_DEBOUNCE_MS=500

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=8
SIMILARITY_THRESHOLD=0.25
MAX_INJECTED_CONTEXT_TOKENS=1200
CONTEXT_RESERVED_TOKENS=512
ALWAYS_INCLUDE_SINGLE_CATEGORY_CAP_PCT=30
ALWAYS_INCLUDE_ALL_CATEGORIES_CAP_PCT=60
GLOBAL_ALWAYS_ON_RETRIEVED_CAP=2
CATEGORY_SELECT_TOP_N=2

# --- Retry / background jobs ---
FAILED_EMBEDDING_RETRY_INTERVAL_SECONDS=300
FAILED_EMBEDDING_MAX_ATTEMPTS=3

# --- Security ---
MAX_RULE_CONTENT_BYTES=131072

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
